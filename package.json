{
    "name": "macro-benchmarks",
    "version": "0.1.0",
    "private": true,
    "description": ".NET Browser WASM Benchmark Suite",
    "type": "module",
    "scripts": {
        "build:charts": "node src/bench-viewer/node_modules/typescript/bin/tsc --project src/bench-viewer/tsconfig.json",
        "build:viewer": "dotnet publish src/bench-viewer/BenchViewer.csproj -c Release -p:BenchmarkPreset=NoWorkload -p:RuntimeFlavor=Mono -p:BuildLabel=viewer -o artifacts/bench-viewer --verbosity minimal",
        "test": "npm run build:charts && node --test tests/unit/*.test.mjs",
        "test:e2e": "npx playwright test tests/e2e/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/blazor-playground/macro-benchmarks.git"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "playwright": "1.58.2"
    },
    "dependencies": {
        "chartjs-adapter-date-fns": "^3.0.0",
        "chartjs-plugin-zoom": "^2.2.0",
        "date-fns": "^3.6.0"
    }
}