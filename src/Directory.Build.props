<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <UseMonoRuntime>false</UseMonoRuntime>
    <RuntimeFlavor>CoreCLR</RuntimeFlavor>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRunComposite>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(Configuration)' == 'Debug'">false</PublishReadyToRunComposite>
    <WasmBuildNative>false</WasmBuildNative>
    <UsingBrowserRuntimeWorkload>false</UsingBrowserRuntimeWorkload>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">false</PublishTrimmed>
    <EnableAggressiveTrimming Condition="'$(Configuration)' == 'Release'">true</EnableAggressiveTrimming>
    <EnableAggressiveTrimming Condition="'$(Configuration)' == 'Debug'">false</EnableAggressiveTrimming>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <MSBuildDisableTaskHost>true</MSBuildDisableTaskHost>
    <WasmFingerprintAssets>true</WasmFingerprintAssets>
    <BlazorFingerprintBlazorJs>true</BlazorFingerprintBlazorJs>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    <StaticWebAssetFingerprintPattern Include="MJS" Pattern="*.mjs" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <Target Name="ValidateBenchmarkConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'"
           Text="This repro requires Debug or Release." />
    <Error Condition="'$(UseMonoRuntime)' != 'false' or '$(RuntimeFlavor)' != 'CoreCLR' or '$(WasmBuildNative)' != 'false'"
           Text="This repro requires the CoreCLR browser runtime without native relinking." />
    <Error Condition="'$(Configuration)' == 'Debug' and ('$(PublishReadyToRun)' != 'true' or '$(PublishReadyToRunComposite)' != 'false' or '$(PublishTrimmed)' != 'false')"
           Text="Debug must interpret untrimmed app assemblies and compile only CoreLib with ReadyToRun." />
    <Error Condition="'$(Configuration)' == 'Release' and ('$(PublishReadyToRun)' != 'true' or '$(PublishReadyToRunComposite)' != 'true' or '@(PublishReadyToRunExclude)' != '' or '@(PublishReadyToRunPartialAssemblies)' != '' or '@(PublishReadyToRunCompositeExclusions)' != '')"
           Text="Release requires full composite ReadyToRun without assembly exclusions." />
  </Target>

  <Target Name="ExcludeNonCoreLibFromReadyToRun"
          BeforeTargets="_PrepareForReadyToRunCompilation"
          DependsOnTargets="_ComputeAssembliesToPostprocessOnPublish"
          Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <PublishReadyToRunExclude Include="@(ResolvedFileToPublish->'%(Filename)%(Extension)')"
                                Condition="'%(ResolvedFileToPublish.PostprocessAssembly)' == 'true' and '%(ResolvedFileToPublish.Filename)' != 'System.Private.CoreLib'" />
    </ItemGroup>
  </Target>

  <!-- The SDK's net11.0 default pack predates browser composite R2R. -->
  <Target Name="UseMatchingWebAssemblyPack" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownWebAssemblySdkPack Update="@(KnownWebAssemblySdkPack)"
                               Condition="'%(KnownWebAssemblySdkPack.TargetFramework)' == 'net11.0'">
        <WebAssemblySdkPackVersion>12.0.0-alpha.1.26509.106</WebAssemblySdkPackVersion>
      </KnownWebAssemblySdkPack>
    </ItemGroup>
  </Target>

  <Target Name="UpdateRuntimePack" AfterTargets="ResolveFrameworkReferences"
          Condition="'$(RuntimePackDir)' != ''">
    <Error Condition="!Exists('$(RuntimePackDir)/runtimes/browser-wasm/native/dotnet.native.wasm')"
           Text="RuntimePackDir must point to an extracted CoreCLR browser-wasm runtime pack." />
    <ItemGroup>
      <ResolvedRuntimePack PackageDirectory="$(RuntimePackDir)"
                           Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
  </Target>
</Project>
