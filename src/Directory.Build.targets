<Project>
    <Target Name="SetBenchmarkPreset" BeforeTargets="Build">
        <Message Text="Using BenchmarkPreset: '$(BenchmarkPreset)'" Importance="High" />
        <Message Text="Using RuntimePackDir: '$(RuntimePackDir)'" Importance="High"
                 Condition="'$(RuntimePackDir)' != ''" />
    </Target>

    <!--
      Override the resolved runtime pack with a custom-built or downloaded one.
      Set /p:RuntimePackDir=<path-to-extracted-nupkg> on the dotnet publish command.
      See docs/runtime-pack.md for details.
    -->
    <Target Name="UpdateRuntimePack" AfterTargets="ResolveFrameworkReferences"
            Condition="'$(RuntimePackDir)' != ''">
        <ItemGroup>
            <ResolvedRuntimePack PackageDirectory="$(RuntimePackDir)"
                                 Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
        </ItemGroup>
        <Message Text="Overriding runtime pack with: $(RuntimePackDir)" Importance="High" />
    </Target>

    <!--
      R2R (CoreCLR `aot` preset): point the WebAssembly SDK pack at the from-source build version so
      its CoreCLR ReadyToRun targets are used. crossgen2 itself comes from /p:Crossgen2InBuildDir at
      targets time, so the crossgen2 pack is left at the SDK default (restored but not used).
      Temporary scaffolding until the R2R targets ship in the SDK's WebAssembly.Pack.
      TODO: remove once https://github.com/dotnet/runtime/pull/133378 merges and flows into the
      daily SDK's Microsoft.NET.Sdk.WebAssembly.Pack.
    -->
    <Target Name="UpdateWasmR2RPacks" BeforeTargets="ProcessFrameworkReferences"
            Condition="'$(WasmR2RPackVersion)' != '' and '$(RuntimeIdentifier)' == 'browser-wasm'">
        <ItemGroup>
            <KnownWebAssemblySdkPack Update="@(KnownWebAssemblySdkPack)">
                <WebAssemblySdkPackVersion>$(WasmR2RPackVersion)</WebAssemblySdkPackVersion>
            </KnownWebAssemblySdkPack>
        </ItemGroup>
    </Target>

    <!--
      CoreCLR browser-wasm interpreter (non-R2R) builds: the CoreCLR runtime pack bundles
      pre-crossgen'd R2R images at runtimes/browser-wasm/native/r2r/*.wasm (one per framework
      assembly). Without PublishReadyToRun the SDK's own prune (_WasmCoreClrPrunePackR2RFromBuild,
      keyed on _WasmRuntimePackR2RDir) doesn't fire, so those images leak into the static web assets
      with AssetTraitValue=native and GenerateWasmBootJson rejects each one ("X.wasm is not
      recognized as any native asset"). Drop them so the interpreter build publishes only the
      managed webcil set.
      TODO: remove once the SDK prunes native/r2r for the non-R2R path (dotnet/runtime#132466).
    -->
    <Target Name="PruneCoreClrR2RImagesForInterp"
            Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(RuntimeFlavor)' == 'CoreCLR' and '$(PublishReadyToRun)' != 'true'"
            BeforeTargets="ProcessPublishFilesForWasm;_ComputeWasmBuildCandidates">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                Condition="'%(Extension)' == '.wasm' and $([MSBuild]::ValueOrDefault('%(Identity)', '').Replace('\', '/').Contains('/native/r2r/'))" />
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                Condition="'%(Extension)' == '.wasm' and $([MSBuild]::ValueOrDefault('%(Identity)', '').Replace('\', '/').Contains('/native/r2r/'))" />
        </ItemGroup>
    </Target>

    <!--
      CoreCLR browser-wasm native-relink needs a crossgen2 that knows the wasm ABI to emit the
      P/Invoke portable call helpers. The stock wasm-tools workload doesn't acquire one nor set
      $(Crossgen2ToolPath), so BrowserWasmApp.CoreCLR.targets errors with "crossgen2 was not found".
      The host crossgen2 pack already ships a wasm-capable crossgen2 (clrjit_universal_wasm), so
      acquire it and point the generator at it. Skipped for the from-source path (which supplies
      $(Crossgen2InBuildDir)) and whenever the SDK already provides crossgen2.
      TODO: remove once dotnet/runtime#133413 + dotnet/sdk#55785 flow into the daily SDK (the
      wasm-tools workload will then acquire crossgen2 and set $(Crossgen2ToolPath)).
    -->
    <ItemGroup Condition="'$(RuntimeFlavor)' == 'CoreCLR'
                          and '$(WasmBuildNative)' == 'true'
                          and '$(Crossgen2InBuildDir)' == ''
                          and '$(DisableRepoWasmCrossgen2)' != 'true'">
        <PackageReference Include="Microsoft.NETCore.App.Crossgen2.$(NETCoreSdkRuntimeIdentifier)"
                          Version="$([MSBuild]::ValueOrDefault('$(RepoWasmCrossgen2Version)', '$(BundledNETCoreAppPackageVersion)'))"
                          ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>

    <Target Name="ProvideWasmCrossgen2ForNativeRelink"
            BeforeTargets="_CoreCLRGenerateManagedToNative"
            Condition="'$(RuntimeIdentifier)' == 'browser-wasm'
                       and '$(RuntimeFlavor)' == 'CoreCLR'
                       and '$(WasmBuildNative)' == 'true'
                       and '$(Crossgen2InBuildDir)' == ''
                       and '$(Crossgen2ToolPath)' == ''
                       and '$(PortableCallHelpersGeneratorPath)' == ''
                       and '$(DisableRepoWasmCrossgen2)' != 'true'">
        <PropertyGroup>
            <_RepoCrossgen2Rid>$(NETCoreSdkRuntimeIdentifier)</_RepoCrossgen2Rid>
            <_RepoCrossgen2Version>$([MSBuild]::ValueOrDefault('$(RepoWasmCrossgen2Version)', '$(BundledNETCoreAppPackageVersion)'))</_RepoCrossgen2Version>
            <_RepoCrossgen2Exe Condition="'$(OS)' == 'Windows_NT'">crossgen2.exe</_RepoCrossgen2Exe>
            <_RepoCrossgen2Exe Condition="'$(OS)' != 'Windows_NT'">crossgen2</_RepoCrossgen2Exe>
            <!-- NuGet global packages folder (NUGET_PACKAGES is set by the bench harness / CI). -->
            <_RepoCrossgen2Folder>$([System.Environment]::GetEnvironmentVariable('NUGET_PACKAGES'))</_RepoCrossgen2Folder>
            <_RepoCrossgen2Folder Condition="'$(_RepoCrossgen2Folder)' == ''">$(NuGetPackageFolders)</_RepoCrossgen2Folder>
            <PortableCallHelpersGeneratorPath>$([MSBuild]::NormalizePath('$(_RepoCrossgen2Folder)', 'microsoft.netcore.app.crossgen2.$(_RepoCrossgen2Rid)', '$(_RepoCrossgen2Version)', 'tools', '$(_RepoCrossgen2Exe)'))</PortableCallHelpersGeneratorPath>
        </PropertyGroup>
        <Error Condition="!Exists('$(PortableCallHelpersGeneratorPath)')"
               Text="Repo crossgen2 hack: '$(PortableCallHelpersGeneratorPath)' does not exist. Ensure package 'Microsoft.NETCore.App.Crossgen2.$(_RepoCrossgen2Rid)' $(_RepoCrossgen2Version) restored into '$(_RepoCrossgen2Folder)'." />
        <Message Importance="High" Text="Repo crossgen2 hack: PortableCallHelpersGeneratorPath=$(PortableCallHelpersGeneratorPath)" />
    </Target>

    <!--
      Override the ASP.NET Core shared framework with a custom-built one.
      Set /p:MicrosoftAspNetCoreVersion=<version> and add a NuGet source pointing
      to the directory containing the built packages.
      The version override in versions.props is sufficient for NuGet packages.
      This target handles the shared framework ref pack override.
    -->
    <Target Name="UpdateAspNetCoreRefPack" AfterTargets="ResolveFrameworkReferences"
            Condition="'$(AspNetCoreRefPackDir)' != ''">
        <ItemGroup>
            <ResolvedFrameworkReference PackageDirectory="$(AspNetCoreRefPackDir)"
                                        Condition="'%(ResolvedFrameworkReference.RuntimeFrameworkName)' == 'Microsoft.AspNetCore.App'" />
        </ItemGroup>
        <Message Text="Overriding ASP.NET Core ref pack with: $(AspNetCoreRefPackDir)" Importance="High" />
    </Target>

    <Target Name="RenameFingerprinting" AfterTargets="ComputeAndCopyFilesToPublishDirectory">
        <PropertyGroup>
            <_PublishedIndexHtml>$(PublishDir)\wwwroot\index.html</_PublishedIndexHtml>
            <_PublishedIndexNFpHtml>$(PublishDir)\wwwroot\index-nfp.html</_PublishedIndexNFpHtml>
        </PropertyGroup>
        <ItemGroup>
            <_FingerprintedMainMjs Include="$(PublishDir)wwwroot/main.*.mjs" />
            <_FingerprintedDotnetJs Include="$(PublishDir)wwwroot/_framework/dotnet.*.js"
                                       Exclude="
                                       $(PublishDir)wwwroot/_framework/dotnet.native.*.js;
                                       $(PublishDir)wwwroot/_framework/dotnet.runtime.*.js;
                                       $(PublishDir)wwwroot/_framework/dotnet.diagnostics.*.js
                                       " />
        </ItemGroup>
        <Copy SourceFiles="@(_FingerprintedMainMjs)"
              DestinationFiles="$(PublishDir)wwwroot/main.mjs"
              Condition="'@(_FingerprintedMainMjs)' != '' and '$(WasmFingerprintAssets)' == 'true'" />
        <Copy SourceFiles="@(_FingerprintedDotnetJs)"
              DestinationFiles="$(PublishDir)wwwroot/_framework/dotnet.js"
              Condition="'@(_FingerprintedDotnetJs)' != '' and '$(WasmFingerprintAssets)' == 'true'" />

        <Copy SourceFiles="$(_PublishedIndexNFpHtml)"
              DestinationFiles="$(_PublishedIndexHtml)"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(_PublishedIndexNFpHtml)') and '$(WasmFingerprintAssets)' != 'true'" />
        <Copy SourceFiles="$(_PublishedIndexNFpHtml).gz"
              DestinationFiles="$(_PublishedIndexHtml).gz"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(_PublishedIndexNFpHtml).gz')  and '$(WasmFingerprintAssets)' != 'true'" />
        <Copy SourceFiles="$(_PublishedIndexNFpHtml).br"
              DestinationFiles="$(_PublishedIndexHtml).br"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(_PublishedIndexNFpHtml).br') and '$(WasmFingerprintAssets)' != 'true'" />
    </Target>
</Project>