<Project>
    <Target Name="SetBenchmarkPreset" BeforeTargets="Build">
        <Message Text="Using BenchmarkPreset: '$(BenchmarkPreset)'" Importance="High" />
        <Message Text="Using RuntimePackDir: '$(RuntimePackDir)'" Importance="High"
                 Condition="'$(RuntimePackDir)' != ''" />
    </Target>

    <!--
      Override the resolved runtime pack with a custom-built or downloaded one.
      Set /p:RuntimePackDir=<path-to-extracted-nupkg> on the dotnet publish command.
      See docs/runtime-pack.md for details.
    -->
    <Target Name="UpdateRuntimePack" AfterTargets="ResolveFrameworkReferences"
            Condition="'$(RuntimePackDir)' != ''">
        <ItemGroup>
            <ResolvedRuntimePack PackageDirectory="$(RuntimePackDir)"
                                 Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
        </ItemGroup>
        <Message Text="Overriding runtime pack with: $(RuntimePackDir)" Importance="High" />
    </Target>

    <!--
      R2R (CoreCLR `aot` preset): point the WebAssembly SDK pack at the from-source build version so
      its CoreCLR ReadyToRun targets are used. crossgen2 itself comes from /p:Crossgen2InBuildDir at
      targets time, so the crossgen2 pack is left at the SDK default (restored but not used).
      Temporary scaffolding until the R2R targets ship in the SDK's WebAssembly.Pack.
      TODO: remove once https://github.com/dotnet/runtime/pull/133378 merges and flows into the
      daily SDK's Microsoft.NET.Sdk.WebAssembly.Pack.
    -->
    <Target Name="UpdateWasmR2RPacks" BeforeTargets="ProcessFrameworkReferences"
            Condition="'$(WasmR2RPackVersion)' != '' and '$(RuntimeIdentifier)' == 'browser-wasm'">
        <ItemGroup>
            <KnownWebAssemblySdkPack Update="@(KnownWebAssemblySdkPack)">
                <WebAssemblySdkPackVersion>$(WasmR2RPackVersion)</WebAssemblySdkPackVersion>
            </KnownWebAssemblySdkPack>
        </ItemGroup>
    </Target>

    <!--
      Override the ASP.NET Core shared framework with a custom-built one.
      Set /p:MicrosoftAspNetCoreVersion=<version> and add a NuGet source pointing
      to the directory containing the built packages.
      The version override in versions.props is sufficient for NuGet packages.
      This target handles the shared framework ref pack override.
    -->
    <Target Name="UpdateAspNetCoreRefPack" AfterTargets="ResolveFrameworkReferences"
            Condition="'$(AspNetCoreRefPackDir)' != ''">
        <ItemGroup>
            <ResolvedFrameworkReference PackageDirectory="$(AspNetCoreRefPackDir)"
                                        Condition="'%(ResolvedFrameworkReference.RuntimeFrameworkName)' == 'Microsoft.AspNetCore.App'" />
        </ItemGroup>
        <Message Text="Overriding ASP.NET Core ref pack with: $(AspNetCoreRefPackDir)" Importance="High" />
    </Target>

    <Target Name="RenameFingerprinting" AfterTargets="ComputeAndCopyFilesToPublishDirectory">
        <PropertyGroup>
            <_PublishedIndexHtml>$(PublishDir)\wwwroot\index.html</_PublishedIndexHtml>
            <_PublishedIndexNFpHtml>$(PublishDir)\wwwroot\index-nfp.html</_PublishedIndexNFpHtml>
        </PropertyGroup>
        <ItemGroup>
            <_FingerprintedMainMjs Include="$(PublishDir)wwwroot/main.*.mjs" />
            <_FingerprintedDotnetJs Include="$(PublishDir)wwwroot/_framework/dotnet.*.js"
                                       Exclude="
                                       $(PublishDir)wwwroot/_framework/dotnet.native.*.js;
                                       $(PublishDir)wwwroot/_framework/dotnet.runtime.*.js;
                                       $(PublishDir)wwwroot/_framework/dotnet.diagnostics.*.js
                                       " />
        </ItemGroup>
        <Copy SourceFiles="@(_FingerprintedMainMjs)"
              DestinationFiles="$(PublishDir)wwwroot/main.mjs"
              Condition="'@(_FingerprintedMainMjs)' != '' and '$(WasmFingerprintAssets)' == 'true'" />
        <Copy SourceFiles="@(_FingerprintedDotnetJs)"
              DestinationFiles="$(PublishDir)wwwroot/_framework/dotnet.js"
              Condition="'@(_FingerprintedDotnetJs)' != '' and '$(WasmFingerprintAssets)' == 'true'" />

        <Copy SourceFiles="$(_PublishedIndexNFpHtml)"
              DestinationFiles="$(_PublishedIndexHtml)"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(_PublishedIndexNFpHtml)') and '$(WasmFingerprintAssets)' != 'true'" />
        <Copy SourceFiles="$(_PublishedIndexNFpHtml).gz"
              DestinationFiles="$(_PublishedIndexHtml).gz"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(_PublishedIndexNFpHtml).gz')  and '$(WasmFingerprintAssets)' != 'true'" />
        <Copy SourceFiles="$(_PublishedIndexNFpHtml).br"
              DestinationFiles="$(_PublishedIndexHtml).br"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(_PublishedIndexNFpHtml).br') and '$(WasmFingerprintAssets)' != 'true'" />
    </Target>
</Project>