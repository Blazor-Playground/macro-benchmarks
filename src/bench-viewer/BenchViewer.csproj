<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>$(BenchmarkTargetFramework)</TargetFramework>
    <DashName>bench-viewer</DashName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmFingerprintAssets>true</WasmFingerprintAssets>
    <BlazorFingerprintBlazorJs>true</BlazorFingerprintBlazorJs>
    <CompressionEnabled>false</CompressionEnabled>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftAspNetCoreVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!-- Generate BuildConfig.g.cs with MSBuild properties available at runtime -->
  <Target Name="GenerateBuildConfig" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_BuildConfigFile>$(IntermediateOutputPath)BuildConfig.g.cs</_BuildConfigFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildConfigFile)" Overwrite="true" Lines="namespace BenchViewer.Models%3B;internal static class BuildConfig;{;    public const string GitHubRepo = &quot;$(GitHubRepo)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(_BuildConfigFile)" />
    </ItemGroup>
  </Target>

  <!-- TypeScript compilation -->
  <PropertyGroup>
    <NpmInstallStamp>node_modules/.install-stamp</NpmInstallStamp>
  </PropertyGroup>

  <ItemGroup>
    <TypeScriptSource Include="chart\**\*.ts" />
    <None Remove="chart\**" />
  </ItemGroup>

  <Target Name="NpmInstall" Inputs="package.json;package-lock.json" Outputs="$(NpmInstallStamp)">
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(NpmInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="CompileTypeScript" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="NpmInstall">
    <Exec Command="node node_modules/typescript/bin/tsc --project tsconfig.json" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Copy SourceFiles="node_modules/bootstrap/dist/css/bootstrap.min.css;node_modules/bootstrap/dist/css/bootstrap.min.css.map"
          DestinationFolder="wwwroot/lib/bootstrap/dist/css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="node_modules/bootstrap/LICENSE" DestinationFolder="wwwroot/lib/bootstrap" SkipUnchangedFiles="true" />
    <!-- These files do not exist at project evaluation on a clean checkout. -->
    <ItemGroup>
      <Content Include="wwwroot/chart/**/*.js;wwwroot/lib/bootstrap/**/*" Exclude="@(Content)" />
      <FileWrites Include="wwwroot/chart/**/*.js;wwwroot/lib/bootstrap/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveStaleViewerBootstraps" BeforeTargets="ComputeAndCopyFilesToPublishDirectory">
    <!-- The shared alias target requires one current fingerprint when republishing. -->
    <ItemGroup>
      <_StaleViewerBootstrap Include="$(PublishDir)wwwroot/main.*.mjs;$(PublishDir)wwwroot/_framework/dotnet.*.js"
                             Exclude="$(PublishDir)wwwroot/_framework/dotnet.native*.js;$(PublishDir)wwwroot/_framework/dotnet.runtime*.js;$(PublishDir)wwwroot/_framework/dotnet.diagnostics*.js" />
    </ItemGroup>
    <Delete Files="@(_StaleViewerBootstrap)" />
  </Target>

</Project>
