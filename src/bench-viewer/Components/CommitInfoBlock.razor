@namespace BenchViewer.Components
@using BenchViewer.Models

<div class="commit-info-block mb-2">
    <div class="mb-1">
        <div class="commit-heading">
            @if (Point.Column.IsAspnetCoreCustomBuild && !string.IsNullOrEmpty(Point.Column.AspnetCoreCommitMessage))
            {
                @TruncateMessage(Point.Column.AspnetCoreCommitMessage, 80)
            }
            else if (!string.IsNullOrEmpty(Point.Column.RuntimeCommitMessage))
            {
                @TruncateMessage(Point.Column.RuntimeCommitMessage, 80)
            }
            else
            {
                <span>@Point.FormattedDate</span>
            }
        </div>
    </div>

    <table class="commit-table">
        <tbody>
            <tr>
                <td class="commit-label">Date</td>
                <td class="py-0">@Point.FormattedDate</td>
            </tr>
            @if (Point.Column.IsAspnetCoreCustomBuild && !string.IsNullOrEmpty(Point.Column.AspnetCoreCommitAuthor))
            {
                <tr>
                    <td class="commit-label">Author</td>
                    <td class="py-0">@Point.Column.AspnetCoreCommitAuthor</td>
                </tr>
            }
            else if (!string.IsNullOrEmpty(Point.Column.RuntimeCommitAuthor))
            {
                <tr>
                    <td class="commit-label">Author</td>
                    <td class="py-0">@Point.Column.RuntimeCommitAuthor</td>
                </tr>
            }
            <tr>
                <td class="commit-label">SDK</td>
                <td class="commit-value-break">
                    @if (!string.IsNullOrEmpty(Point.Column.VmrGitHash))
                    {
                        <a href="https://github.com/dotnet/dotnet/commit/@Point.Column.VmrGitHash" target="_blank" rel="noopener">@Point.Column.SdkVersion</a>
                    }
                    else
                    {
                        @Point.Column.SdkVersion
                    }
                </td>
            </tr>
            <tr>
                <td class="commit-label">Row</td>
                <td class="py-0">@Point.RowKey</td>
            </tr>
            @if (!string.IsNullOrEmpty(Point.Column.RuntimePackVersion))
            {
                <tr>
                    <td class="commit-label">Runtime Pack</td>
                    <td class="commit-value-break">
                        @if (Point.Column.IsRuntimeCustomBuild && !string.IsNullOrEmpty(Point.Column.RuntimePR))
                        {
                            <a href="https://github.com/dotnet/runtime/pull/@Point.Column.RuntimePR" target="_blank" rel="noopener">PR#@Point.Column.RuntimePR</a>
                        }
                        else if (!string.IsNullOrEmpty(Point.Column.RuntimeGitHash))
                        {
                            <a href="https://github.com/dotnet/runtime/commit/@Point.Column.RuntimeGitHash" target="_blank" rel="noopener">@Point.Column.RuntimePackVersion</a>
                        }
                        else
                        {
                            @Point.Column.RuntimePackVersion
                        }
                    </td>
                </tr>
            }
            @if (!string.IsNullOrEmpty(Point.Column.AspnetCoreVersion))
            {
                <tr>
                    <td class="commit-label">ASP.NET Core</td>
                    <td class="commit-value-break">
                        @if (Point.Column.IsAspnetCoreCustomBuild && !string.IsNullOrEmpty(Point.Column.AspnetCorePR))
                        {
                            <a href="https://github.com/dotnet/aspnetcore/pull/@Point.Column.AspnetCorePR" target="_blank" rel="noopener">PR#@Point.Column.AspnetCorePR</a>
                        }
                        else if (!string.IsNullOrEmpty(Point.Column.AspnetCoreGitHash))
                        {
                            <a href="https://github.com/dotnet/aspnetcore/commit/@Point.Column.AspnetCoreGitHash" target="_blank" rel="noopener">@Point.Column.AspnetCoreVersion</a>
                        }
                        else
                        {
                            @Point.Column.AspnetCoreVersion
                        }
                    </td>
                </tr>
            }
            @if (!string.IsNullOrEmpty(Point.Column.WorkloadVersion))
            {
                <tr>
                    <td class="commit-label">Workload</td>
                    <td class="commit-value-break">@Point.Column.WorkloadVersion</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Point.Metrics.Count > 0)
    {
        @if (Expanded)
        {
            <hr class="my-1" />
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong>Metrics:</strong>
                @if (Point.Column.IsPrerelease)
                {
                    <a href="./delta?sdk=@(System.Net.WebUtility.UrlEncode(Point.Column.SdkVersion))" class="small">
                        📊 Delta Report
                    </a>
                }
            </div>
            <div class="metrics-list">
                @foreach (var kv in Point.Metrics)
                {
                    var delta = GetDelta(kv.Key, kv.Value);
                    <div>@delta.Icon @MetricInfo.GetDisplay(kv.Key): @MetricInfo.FormatValue(kv.Key, kv.Value) <span class="@delta.CssClass">@delta.Text</span></div>
                }
            </div>
        }
        else
        {
            <details class="mt-1">
                <summary class="metrics-summary">Metrics</summary>
                <div class="mt-1 metrics-list">
                    @foreach (var kv in Point.Metrics)
                    {
                        var delta = GetDelta(kv.Key, kv.Value);
                        <div>@delta.Icon @MetricInfo.GetDisplay(kv.Key): @MetricInfo.FormatValue(kv.Key, kv.Value) <span class="@delta.CssClass">@delta.Text</span></div>
                    }
                </div>
            </details>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public SelectedPointInfo Point { get; set; } = default!;
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public Dictionary<string, double>? PreviousMetrics { get; set; }

    private static readonly HashSet<string> HigherIsBetter = new()
    {
        "js-interop-ops", "json-parse-ops", "exception-ops"
    };

    private static bool IsHigherBetter(string metricKey)
        => HigherIsBetter.Contains(metricKey) || metricKey.StartsWith("blazor-");

    private record struct MetricDelta(string Icon, string Text, string CssClass);

    private MetricDelta GetDelta(string metricKey, double currentValue)
    {
        if (PreviousMetrics == null || !PreviousMetrics.TryGetValue(metricKey, out var prevValue) || prevValue == 0)
            return new("", "", "");

        var pct = (currentValue - prevValue) / prevValue * 100;
        if (Math.Abs(pct) < 0.01)
            return new("", "", "");

        var isImprovement = IsHigherBetter(metricKey) ? pct > 0 : pct < 0;
        var icon = isImprovement ? "🟢" : "🔴";
        var sign = pct > 0 ? "+" : "";
        var text = $"{sign}{pct:F1}%";
        var css = isImprovement ? "text-success" : "text-danger";
        return new(icon, text, css);
    }

    private static string TruncateMessage(string msg, int max)
    {
        var idx = msg.IndexOfAny(new[] { '\r', '\n' });
        if (idx >= 0) msg = msg[..idx];
        return msg.Length <= max ? msg : msg[..(max - 1)] + "…";
    }
}
