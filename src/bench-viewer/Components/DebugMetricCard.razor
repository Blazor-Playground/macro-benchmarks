<article class="focus-card @(!GraphsEnabled ? "focus-summary-only" : "")" data-metric="@Metric.Id" data-status="@Metric.Status">
    <div class="focus-card-summary">
        <h3>@Metric.Title</h3>
        <p class="debug-boundary">@Metric.Boundary</p>
        <p class="focus-measurement">@Metric.Description</p>
        @if (Metric.Comparison is { } comparison)
        {
            <div class="focus-kpi @comparison.Tone" aria-label="@($"{Metric.Title}: {comparison.Magnitude} {comparison.Verdict}")">
                <span class="focus-percentage">@comparison.Magnitude</span><span class="focus-verdict">@comparison.Verdict</span>
            </div>
            @if (Metric.AverageComparison is { } average && Metric.Latest?.PercentWindow is { } window)
            {
                <p class="focus-rolling-caption" title="@AverageDescription(window, true)"
                    data-count="@window.Count" data-end-sdk="@window.LastSdk">
                    (<span class="@average.Tone">@average.Magnitude @average.Verdict</span> · <span class="focus-average-label">5 avg</span>)
                </p>
            }
        }
        <p class="debug-summary-heading">Latest</p>
        <dl class="focus-values">
            @foreach (var (label, result) in new[] { ("CoreCLR Debug", Metric.Coreclr), ("Mono Debug", Metric.Mono) })
            {
                <div><dt>@label</dt><dd>@Metric.Format(result?.ValueMs)</dd></div>
                <div class="debug-result-status">
                    @(result == null ? "Not collected" : $"{result.Status}: {result.Successful}/{result.Requested} successful trials")
                    @if (result?.ValueMs != null) { <span> (median)</span> }
                </div>
                @if (!string.IsNullOrEmpty(result?.Reason)) { <p class="debug-reason">@result.Reason</p> }
            }
        </dl>
        <dl class="debug-average-values" aria-label="Five-observation averages">
            @foreach (var (label, runtime, window) in new[]
            {
                ("CoreCLR Debug", "coreclr", Metric.Latest?.CoreclrWindow),
                ("Mono Debug", "mono", Metric.Latest?.MonoWindow),
            })
            {
                <div data-runtime="@runtime" data-count="@(window?.Count ?? 0)" title="@AverageDescription(window)">
                    <dt>@label · <span class="focus-average-label">5 avg</span>
                        @if (window != null) { <span class="debug-average-count">(@window.Count/5 observations)</span> }
                    </dt>
                    <dd>@Metric.Format(window?.Mean)</dd>
                </div>
            }
        </dl>
        @if (Metric.Id == "rebuild")
        {
            <details class="debug-build-breakdown">
                <summary>Build time breakdown</summary>
                <p class="debug-build-detail"><strong>Build only:</strong> CoreCLR @Metric.Format(Metric.BuildCoreclr?.ValueMs);
                    Mono @Metric.Format(Metric.BuildMono?.ValueMs). Part of the loop above, not a separate end-to-end metric.</p>
                <p class="debug-build-detail"><strong>5 avg:</strong>
                    CoreCLR @Metric.Format(Metric.BuildCoreclrAverage?.Mean) (@(Metric.BuildCoreclrAverage?.Count ?? 0)/5);
                    Mono @Metric.Format(Metric.BuildMonoAverage?.Mean) (@(Metric.BuildMonoAverage?.Count ?? 0)/5).</p>
            </details>
        }
        @if (Metric.Comparison == null) { <p class="focus-summary-note">@Metric.Message</p> }
        @if (Metric.OlderPair) { <p class="focus-older-pair">Latest complete pair; newer batch is incomplete</p> }
        @if (Metric.Smoke || (!Metric.Controlled && !Metric.LocalPaired))
        {
            <p class="debug-result-status">@(Metric.Smoke ? "Smoke run: not a performance comparison." : "No controlled paired-runner result.")</p>
        }
        else if (Metric.LocalPaired)
        {
            <p class="debug-result-status">Full local paired run · same host, not CI or hardware-isolated</p>
        }
        @if (Metric.Sdk != null)
        {
            <details class="debug-properties">
                <summary>Evaluated Debug settings</summary>
                @foreach (var (label, result) in new[] { ("CoreCLR", Metric.Coreclr), ("Mono", Metric.Mono) })
                {
                    <strong>@label</strong>
                    <dl>@foreach (var property in result?.Properties ?? new()) { <dt>@property.Key</dt><dd>@(property.Value.Length == 0 ? "(SDK default / unset)" : property.Value)</dd> }</dl>
                }
            </details>
        }
    </div>
    @if (GraphsEnabled)
    {
        <div class="focus-card-chart">
            @if (Metric.Points.Any(p => (Measurements && (p.Mono > 0 || p.Coreclr > 0)) || (Percentage && p.Percent != null)))
            {
                <div class="focus-plot"><canvas id="@($"focus-{Owner}-{Metric.Id}")" role="img"
                    aria-label="@($"{Metric.Title}. Recorded median durations in {Metric.Unit}; SDK observation order, not elapsed time.")"></canvas></div>
            }
            else { <div class="focus-empty"><strong>No comparable history</strong><p>@Metric.Message</p></div> }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public DebugMetricReport Metric { get; set; } = new();
    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public bool Measurements { get; set; }
    [Parameter] public bool Percentage { get; set; }
    private bool GraphsEnabled => Measurements || Percentage;
    private static string AverageDescription(FocusWindow? window, bool percentage = false) => window == null
        ? "No complete non-smoke observations for a rolling average."
        : $"{window.Count} of 5 available consecutive observations, ending at SDK {window.LastSdk}. "
            + $"Window {window.FirstDay} to {window.LastDay}. "
            + (percentage ? "Mean of individual same-batch CoreCLR-versus-Mono percentages, not a ratio of means."
                : "Mean of the recorded per-batch medians, not pooled individual trials.");
}
