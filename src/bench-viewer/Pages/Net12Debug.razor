@page "/net12-debug"
@implements IDisposable

<PageTitle>NET12 dev-loop - .NET WASM Benchmarks</PageTitle>
<div class="net12-focus debug-dashboard">
    <div class="focus-workbench">
        <aside class="focus-settings" aria-label="NET12 dev-loop settings">
            <DashboardSidebarHeader Active="debug" />
            <label for="debug-app">Application</label>
            <select id="debug-app" value="@app" @onchange="ChangeApp">
                @foreach (var id in report?.Apps ?? ["empty-blazor", "havit-bootstrap"])
                {
                    <option value="@id">@DashboardConfig.AppName(id)</option>
                }
            </select>
            <div class="focus-selection-control">
                <label for="debug-cohort">Recorded environment / methodology</label>
                <select id="debug-cohort" value="@cohort" @onchange="ChangeCohort" disabled="@(report?.Cohorts.Count is not > 0)">
                    @if (report?.Cohorts.Count is not > 0) { <option>No clean-Debug cohort published</option> }
                    @foreach (var item in report?.Cohorts ?? [])
                    {
                        <option value="@item.Id">@item.Label</option>
                    }
                </select>
            </div>
            <fieldset>
                <legend>History window</legend>
                <div class="focus-range-buttons">
                    @foreach (var option in Ranges)
                    {
                        <button type="button" data-range="@option.Value" aria-pressed="@(range == option.Value ? "true" : "false")"
                            @onclick="() => ChangeRange(option.Value)">@option.Label</button>
                    }
                </div>
                <p class="focus-range-note">@report?.StartDay to @report?.EndDay<br />Inclusive SDK days / UTC</p>
            </fieldset>
            <fieldset class="focus-graph-settings">
                <legend>Graph settings</legend>
                <label class="focus-curve-toggle"><input id="debug-measurements" type="checkbox" checked="@measurements" @onchange="ChangeMeasurements" />Actual measurements</label>
                <label class="focus-curve-toggle"><input id="debug-percentage" type="checkbox" checked="@percentage" @onchange="ChangePercentage" />Percentage curve</label>
                <p class="focus-setting-hint">Recorded per-batch medians; no smoothing. Graph controls never change samples or summaries.</p>
            </fieldset>
            <div class="focus-cohort">
                <p class="focus-eyebrow">COMPARISON CONTEXT</p>
                <dl>
                    <div><dt>Preset / configuration</dt><dd>dev-loop · Debug (SDK defaults)</dd></div>
                    <div><dt>Runtime</dt><dd>CoreCLR vs Mono</dd></div>
                    <div><dt>Browser / profile</dt><dd>Chromium / desktop, unthrottled</dd></div>
                    <div><dt>Managed debugger</dt><dd>Detached</dd></div>
                </dl>
                <p class="focus-setting-hint">Clean dev-loop configuration, not a clean rebuild on every iteration. No tuned-history, publish or R2R fallback.</p>
            </div>
        </aside>
        <main class="focus-main">
            <div class="focus-heading"><h1>NET12 dev-loop<span>.</span></h1>
                <p>Debug scenarios from <a href="https://github.com/dotnet/runtime/issues/133691">dotnet/runtime#133691</a>: run to first render, development loop and optional walkthrough.</p>
            </div>
            <div class="focus-provenance">
                <strong>Complete, non-smoke, same-runner pairs only. Local results are experiments, not isolated CI baselines.</strong>
                <a href="net12-debug#debug-methodology">Metric definitions</a>
            </div>
            <div class="focus-chart-toolbar">
                <strong>@DashboardConfig.AppName(app)</strong>
                <button type="button" @onclick="Refresh">Refresh data</button>
            </div>
            @if (error != null)
            {
                <div class="focus-error" role="alert"><strong>Unable to load clean-Debug results.</strong> @error
                    <button type="button" @onclick="Refresh">Retry</button></div>
            }
            else if (loading) { <p role="status">Loading clean-Debug results...</p> }
            else if (report != null)
            {
                @if (!measurements && !percentage) { <p role="status">Graphs off · summaries still update</p> }
                @foreach (var group in MetricGroups)
                {
                    <section class="debug-metric-group" aria-labelledby="@($"debug-{group.Id}-title")">
                        <h2 id="@($"debug-{group.Id}-title")">@group.Title</h2>
                        <p class="debug-group-description">@group.Description</p>
                        <div class="focus-metrics">
                            @foreach (var metric in report.Metrics.Where(metric => group.MetricIds.Contains(metric.Id)))
                            {
                                <DebugMetricCard @key="metric.Id" Metric="@metric" Owner="@owner" Measurements="@measurements" Percentage="@percentage" />
                            }
                        </div>
                    </section>
                }
                <p class="focus-coverage">Publication refreshed @report.LastUpdated. SDK build day is separate from actual measurement UTC.</p>
                @if (report.RawDataPath != null)
                {
                    <p><a href="@report.RawDataPath" target="_blank" rel="noopener">Raw batch and per-trial evidence</a></p>
                }
            }
            <details id="debug-methodology" class="focus-methodology">
                <summary>How these measurements work</summary>
                <p>First run includes dotnet run's build and normal restore check, development-host startup, navigation and a real rendered-app acknowledgement.
                    Dependencies are prepared and the browser is prelaunched. The endpoint includes a paint opportunity, not physical display presentation or LCP.</p>
                <p>Incremental dotnet run starts its timer when a fresh dotnet run is launched. The source edit is already saved and
                    the previous process is already stopped. Previous build outputs and browser cache are retained; the command's
                    incremental build, host startup and first render are timed.</p>
                <p>Incremental rebuild starts its timer when the edit is saved while the app is running. It includes stopping the app,
                    dotnet build, dotnet run --no-build and updated render. This is a scripted restart loop, not an automatic watch restart.
                    The build-only duration is a breakdown of this metric, not another end-to-end scenario.</p>
                <p>Hot reload requires an applied managed delta, changed rendered output, preserved state and unchanged document/runtime/host identities.
                    A page reload or restart is a failure, never a substitute. Runtime capability failures remain visible.
                    CoreCLR WASM hot-reload enablement is tracked in <a href="https://github.com/dotnet/runtime/issues/134337">dotnet/runtime#134337</a>.</p>
                <p>The dev-loop preset sets only Configuration=Debug. SDK defaults and actual evaluated settings are recorded separately for each runtime.
                    Older tuned DevLoop records and historical publish measurements do not supply these live metrics.
                    Each date/rerun is a distinct observation. Cohorts do not mix SDK targets, app/harness revisions, browsers or environment policies.</p>
                <p>Percentages compare CoreCLR duration with Mono in the same complete batch: positive means slower, negative faster.
                    Colors are not statistical significance. Local paired batches disclose shared-host conditions and do not claim CI control.
                    Unsupported, failed and partial batches have no comparative headline.
                    This dashboard implements the Debug scenarios in <a href="https://github.com/dotnet/runtime/issues/133691">dotnet/runtime#133691</a>.</p>
            </details>
        </main>
    </div>
</div>
