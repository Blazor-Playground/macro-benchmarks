@page "/params-count-server"
@rendermode InteractiveServer
@inherits MeasuredComponentBase

<h1>Parameters Count (Server)</h1>
<p data-testid="render-count">Renders: @renderCount</p>

<div style="overflow:hidden;height:0">
@for (int i = 0; i < 500; i++)
{
    var val = $"{renderCount}-{i}";
    <TableCell_ManyParameters
        Param1="@val" Param2="@val" Param3="@val" Param4="@val" Param5="@val"
        Param6="@val" Param7="@val" Param8="@val" Param9="@val" Param10="@val" />
}
</div>

@code {
    private int renderCount = 0;

    protected override void MutateState()
    {
        renderCount++;
    }
}
