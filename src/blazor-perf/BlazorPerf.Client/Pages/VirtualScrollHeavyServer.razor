@page "/virtualscroll-heavy-server"
@rendermode InteractiveServer
@inherits MeasuredComponentBase

<h1>VirtualScroll Heavy (Server)</h1>

<div style="height:500px;overflow-y:auto" data-testid="scroll-container" tabindex="0">
    <table class="table">
        <thead>
            <tr>
                <th>Index</th>
                <th>Name</th>
                <th>Value</th>
                <th>Status</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            <Virtualize ItemsProvider="LoadItems" Context="item" OverscanCount="5">
                <tr>
                    <td>@item.Index</td>
                    <td>@item.Name</td>
                    <td>@item.Value</td>
                    <td>@item.Status</td>
                    <td>@item.Score.ToString("F2")</td>
                </tr>
            </Virtualize>
        </tbody>
    </table>
</div>

@code {
    private int generation = 0;
    private static readonly string[] Statuses = { "Active", "Pending", "Closed", "Review", "Archived" };

    protected override void MutateState()
    {
        generation++;
    }

    private ValueTask<ItemsProviderResult<RowItem>> LoadItems(ItemsProviderRequest request)
    {
        var items = new RowItem[request.Count];
        for (int i = 0; i < request.Count; i++)
        {
            var idx = request.StartIndex + i;
            items[i] = new RowItem
            {
                Index = idx,
                Name = $"Item-{generation}-{idx}",
                Value = $"Val-{(idx * 7 + generation) % 1000}",
                Status = Statuses[(idx + generation) % Statuses.Length],
                Score = (idx * 3.14 + generation) % 100.0
            };
        }
        return ValueTask.FromResult(new ItemsProviderResult<RowItem>(items, 10_000));
    }

    private record struct RowItem
    {
        public int Index { get; init; }
        public string Name { get; init; }
        public string Value { get; init; }
        public string Status { get; init; }
        public double Score { get; init; }
    }
}
