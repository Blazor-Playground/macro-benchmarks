@page "/too-many-components-ssr"
@using BlazorPerf.Client.Shared

<h1>Too Many Components (SSR)</h1>
<p data-testid="render-count">Renders: 1</p>

<table style="display:none">
<tbody>
@for (int i = 0; i < 1000; i++)
{
    var row = i;
    <TableRow>
        <TableCell><span>ssr-@row-A</span></TableCell>
        <TableCell><span>ssr-@row-B</span></TableCell>
        <TableCell><span>ssr-@row-C</span></TableCell>
    </TableRow>
}
</tbody>
</table>
