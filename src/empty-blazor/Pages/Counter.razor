@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status" data-testid="counter-value">Current count: @currentCount</p>

<button class="btn btn-primary" data-testid="counter-button" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine($"Counter component rendered. Current count: {currentCount}");
    }
}
