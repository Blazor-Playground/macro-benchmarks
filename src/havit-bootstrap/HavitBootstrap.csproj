<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Havit.Blazor.Documentation</AssemblyName>
    <RootNamespace>Havit.Blazor.Documentation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8669;CS8632</NoWarn>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WasmDebuggerWorkload)' == 'true'">
    <CopyOutputSymbolsToPublishDirectory>true</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(WasmDebuggerWorkload)' == 'true'">
    <AssemblyMetadata Include="HavitDebuggerCompilationMode" Value="fully-interpreted-no-r2r" />
    <AssemblyMetadata Include="HavitDebuggerScenario" Value="$(HavitDebuggerScenario)" />
    <RuntimeHostConfigurationOption Include="Havit.DebuggerWorkload.CompilationMode" Value="fully-interpreted-no-r2r" />
    <RuntimeHostConfigurationOption Include="Havit.DebuggerWorkload.Scenario" Value="$(HavitDebuggerScenario)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="12.0.0-alpha.1.26472.116" />
    <PackageReference Include="Havit.Blazor.Components.Web" Version="4.23.0" />
    <PackageReference Include="Havit.Blazor.Components.Web.Bootstrap" Version="4.23.0" />
    <PackageReference Include="Havit.Blazor.Components.Web.Bootstrap.Smart" Version="4.23.0-preview04" />
    <PackageReference Include="Havit.Blazor.Components.Web.ECharts" Version="4.23.0" />
    <PackageReference Include="Havit.Blazor.GoogleTagManager" Version="4.23.0" />
  </ItemGroup>

</Project>
