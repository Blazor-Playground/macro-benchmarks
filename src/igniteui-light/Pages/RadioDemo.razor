@page "/radio"

<PageTitle>Radio Demo</PageTitle>

<h3>Radio / Radio Group</h3>

<IgbRadioGroup @bind-Value="SelectedPlan" Alignment="@ContentOrientation.Vertical" Name="plan">
    <IgbRadio Value="Plan.Basic">Basic</IgbRadio>
    <IgbRadio Value="Plan.Pro">Pro</IgbRadio>
    <IgbRadio Value="Plan.Enterprise">Enterprise</IgbRadio>
</IgbRadioGroup>

<p>Selected plan: @SelectedPlan</p>

<h4>Horizontal</h4>

<IgbRadioGroup TValue="string" Alignment="@ContentOrientation.Horizontal" Name="color">
    <IgbRadio Value="@("red")">Red</IgbRadio>
    <IgbRadio Value="@("green")">Green</IgbRadio>
    <IgbRadio Value="@("blue")">Blue</IgbRadio>
</IgbRadioGroup>

@code {
    enum Plan { Basic, Pro, Enterprise }

    Plan SelectedPlan { get; set; } = Plan.Pro;
}
