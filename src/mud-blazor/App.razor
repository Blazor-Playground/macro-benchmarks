<Router AppAssembly="@typeof(MudBlazor.Docs.Pages.Index).Assembly" OnNavigateAsync="OnNavigate">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MudBlazor.Docs.Shared.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MudBlazor.Docs.Shared.MainLayout)">
            <p>Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private void OnNavigate(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        Console.WriteLine($"Navigating to: {context.Path}");
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine($"App rendered after navigation. FirstRender: {firstRender}");
    }
}
